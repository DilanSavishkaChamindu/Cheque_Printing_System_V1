generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum PlatformAdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  EXPIRED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum CompanyAccessScope {
  ALL_COMPANIES
  SELECTED_COMPANIES
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum ActorType {
  PLATFORM_ADMIN
  TENANT_USER
  SYSTEM
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_REVOKED
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum BankAccountType {
  CURRENT
  SAVINGS
  OVERDRAFT
  OTHER
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
  FROZEN
}

enum BankTransactionType {
  OPENING_BALANCE
  DEPOSIT
  WITHDRAWAL
  CHEQUE_PAYMENT
  RECEIVED_CHEQUE_DEPOSIT
  ADJUSTMENT
  REVERSAL
}

enum AdjustmentType {
  CREDIT
  DEBIT
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  POSTED
  REJECTED
}

enum ChequeBookStatus {
  ACTIVE
  EXHAUSTED
  INACTIVE
  CANCELLED
}

enum AllocationType {
  ONLINE_SINGLE
  OFFLINE_RANGE
}

enum AllocationStatus {
  ACTIVE
  EXHAUSTED
  REVOKED
  EXPIRED
}

enum PaymentType {
  ACCOUNT_PAYEE
  CASH
}

enum ChequeBusinessStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum ChequePrintingStatus {
  NOT_PRINTED
  PRINTED
  PRINT_FAILED
}

enum ChequeBankingStatus {
  PENDING
  PRESENTED
  CLEARED
  BOUNCED
  STOPPED
  POSTPONED
}

enum ChequeStatusCategory {
  BUSINESS
  PRINTING
  BANKING
}

enum PrintJobType {
  INITIAL_PRINT
  REPRINT
  TEST_PRINT
  PDF_EXPORT
}

enum PrintJobStatus {
  QUEUED
  SUCCESS
  FAILED
}

enum ReceivedChequeStatus {
  RECEIVED
  PENDING_DEPOSIT
  DEPOSITED
  CLEARED
  BOUNCED
  RETURNED
  CANCELLED
}

enum PaperOrientation {
  PORTRAIT
  LANDSCAPE
}

enum FeedDirection {
  TOP_FIRST
  BOTTOM_FIRST
  LEFT_FIRST
  RIGHT_FIRST
}

enum TemplateFieldKey {
  CHEQUE_DATE
  PAYEE_NAME
  AMOUNT_NUMBER
  AMOUNT_WORDS_LINE_1
  AMOUNT_WORDS_LINE_2
  PAYMENT_TYPE_MARK
  CASH_RECIPIENT
  LEFT_EDGE_MARKING
  COMPANY_STAMP
  CUSTOM_TEXT
}

enum TextAlignment {
  LEFT
  CENTER
  RIGHT
}

enum SyncOperationType {
  CREATE
  UPDATE
  STATUS_CHANGE
  PRINT_RECORD
}

enum SyncOperationStatus {
  PENDING
  PROCESSING
  SYNCHRONIZED
  CONFLICT
  FAILED
  REJECTED
}

enum SyncConflictType {
  VERSION_MISMATCH
  CHEQUE_NUMBER_COLLISION
  FEATURE_DISABLED
  PERMISSION_REVOKED
  TENANT_INACTIVE
  VALIDATION_CONFLICT
}

enum ConflictResolutionStatus {
  OPEN
  RESOLVED_KEEP_SERVER
  RESOLVED_APPLY_LOCAL
  RESOLVED_MERGED
  DISCARDED
}

enum ExportFormat {
  PDF
  EXCEL
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum BackupScope {
  TENANT_EXPORT
  PLATFORM_FULL
}

enum RestoreStatus {
  PREVIEWED
  CONFIRMED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

// ============================================================================
// 8.1 PLATFORM TABLES
// ============================================================================

model PlatformAdministrator {
  id                String              @id @default(uuid()) @db.Char(36)
  firstName         String              @db.VarChar(100)
  lastName          String              @db.VarChar(100)
  email             String              @unique @db.VarChar(191)
  username          String              @unique @db.VarChar(100)
  passwordHash      String              @db.VarChar(255)
  status            PlatformAdminStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  passwordUpdatedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sessions            PlatformSession[]
  auditLogs           PlatformAuditLog[]
  passwordResetTokens PasswordResetToken[]
  authoredAuditLogs   AuditLog[]           @relation("AuditPlatformAdmin")
}

model PlatformSession {
  id               String    @id @default(uuid()) @db.Char(36)
  platformAdminId  String    @db.Char(36)
  refreshTokenHash String    @unique @db.VarChar(128)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.Text
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?   @db.VarChar(255)
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())

  platformAdmin PlatformAdministrator @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId, expiresAt])
}

model Tenant {
  id                     String       @id @default(uuid()) @db.Char(36)
  tenantCode             String       @unique @db.VarChar(64)
  organizationName       String       @db.VarChar(191)
  registeredBusinessName String?      @db.VarChar(191)
  contactPerson          String       @db.VarChar(150)
  email                  String       @db.VarChar(191)
  contactNumber          String?      @db.VarChar(50)
  address                String?      @db.Text
  country                String       @db.VarChar(100)
  registrationNumber     String?      @db.VarChar(100)
  status                 TenantStatus @default(PENDING)
  defaultCompanyId       String?      @db.Char(36)
  statusReason           String?      @db.VarChar(255)
  suspendedAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  createdBy              String?      @db.Char(36)
  updatedBy              String?      @db.Char(36)

  settings               TenantSetting?
  tenantFeatures         TenantFeature[]
  featureHistory         TenantFeatureHistory[]
  subscriptions          Subscription[]
  platformAuditLogs      PlatformAuditLog[]
  users                  User[]
  roles                  Role[]
  userRoles              UserRole[]
  userPermissionOverrides UserPermissionOverride[]
  userCompanies          UserCompany[]
  userSessions           UserSession[]
  registeredDevices      RegisteredDevice[]
  companies              Company[]              @relation("TenantCompanies")
  defaultCompany         Company?               @relation("TenantDefaultCompany", fields: [defaultCompanyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  companySettings        CompanySetting[]
  banks                  Bank[]
  bankBranches           BankBranch[]
  bankAccounts           BankAccount[]
  bankTransactions       BankAccountTransaction[]
  bankAdjustments        BankAccountAdjustment[]
  chequeBooks            ChequeBook[]
  chequeAllocations      ChequeNumberAllocation[]
  issuedCheques          IssuedCheque[]
  issuedChequeHistories  IssuedChequeStatusHistory[]
  chequePrintJobs        ChequePrintJob[]
  receivedCheques        ReceivedCheque[]
  receivedChequeHistories ReceivedChequeStatusHistory[]
  chequeTemplates        ChequeTemplate[]
  chequeTemplateFields   ChequeTemplateField[]
  calibrationProfiles    ChequeCalibrationProfile[]
  syncOperations         SyncOperation[]
  syncConflicts          SyncConflict[]
  syncLogs               SyncLog[]
  reportExportJobs       ReportExportJob[]
  backupJobs             BackupJob[]
  restoreJobs            RestoreJob[]
  auditLogs              AuditLog[]
  authLogs               AuthenticationLog[]
  securityEvents         SecurityEvent[]

  @@index([status])
  @@index([organizationName])
  @@index([defaultCompanyId])
}

model TenantSetting {
  id                     String   @id @default(uuid()) @db.Char(36)
  tenantId               String   @unique @db.Char(36)
  defaultCurrency        String   @default("LKR") @db.VarChar(10)
  dateFormat             String   @default("DD/MM/YYYY") @db.VarChar(32)
  timezone               String   @default("Asia/Colombo") @db.VarChar(64)
  offlineMaxSessionHours Int      @default(24)
  requireDeviceApproval  Boolean  @default(true)
  fiscalYearStartMonth   Int      @default(1)
  settingsJson           Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Feature {
  id               String   @id @default(uuid()) @db.Char(36)
  key              String   @unique @db.VarChar(64)
  name             String   @db.VarChar(120)
  description      String?  @db.Text
  category         String?  @db.VarChar(64)
  isGlobalActive   Boolean  @default(true)
  isDefaultEnabled Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenantFeatures TenantFeature[]
  featureHistory TenantFeatureHistory[]

  @@index([isGlobalActive, sortOrder])
}

model TenantFeature {
  id             String    @id @default(uuid()) @db.Char(36)
  tenantId       String    @db.Char(36)
  featureId      String    @db.Char(36)
  isEnabled      Boolean   @default(true)
  isOverride     Boolean   @default(false)
  overrideReason String?   @db.VarChar(255)
  expiresAt      DateTime?
  updatedBy      String?   @db.Char(36)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@index([tenantId, isEnabled])
}

model TenantFeatureHistory {
  id                  String    @id @default(uuid()) @db.Char(36)
  tenantId            String    @db.Char(36)
  featureId           String    @db.Char(36)
  previousEnabled     Boolean?
  newEnabled          Boolean
  isOverride          Boolean   @default(false)
  reason              String?   @db.VarChar(255)
  changedByActorType  ActorType
  changedById         String    @db.Char(36)
  createdAt           DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([featureId, createdAt])
}

model Subscription {
  id              String             @id @default(uuid()) @db.Char(36)
  tenantId        String             @db.Char(36)
  planCode        String             @db.VarChar(64)
  planName        String             @db.VarChar(120)
  status          SubscriptionStatus @default(TRIAL)
  maxUsers        Int?
  maxCompanies    Int?
  maxBankAccounts Int?
  startsAt        DateTime
  endsAt          DateTime?
  autoRenew       Boolean            @default(false)
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model PlatformAuditLog {
  id              String   @id @default(uuid()) @db.Char(36)
  platformAdminId String?  @db.Char(36)
  tenantId        String?  @db.Char(36)
  action          String   @db.VarChar(120)
  entityType      String   @db.VarChar(80)
  entityId        String?  @db.Char(36)
  previousValues  Json?
  newValues       Json?
  ipAddress       String?  @db.VarChar(64)
  userAgent       String?  @db.Text
  createdAt       DateTime @default(now())

  platformAdmin PlatformAdministrator? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  tenant        Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([platformAdminId, createdAt])
  @@index([action, createdAt])
}

// ============================================================================
// 8.2 AUTHENTICATION AND AUTHORIZATION TABLES
// ============================================================================

model User {
  id                 String             @id @default(uuid()) @db.Char(36)
  tenantId           String             @db.Char(36)
  firstName          String             @db.VarChar(100)
  lastName           String             @db.VarChar(100)
  email              String             @db.VarChar(191)
  username           String             @db.VarChar(100)
  mobileNumber       String?            @db.VarChar(50)
  passwordHash       String             @db.VarChar(255)
  isClientAdmin      Boolean            @default(false)
  status             UserStatus         @default(ACTIVE)
  companyAccessScope CompanyAccessScope @default(ALL_COMPANIES)
  lastLoginAt        DateTime?
  lastActivityAt     DateTime?
  passwordUpdatedAt  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          String?            @db.Char(36)
  updatedBy          String?            @db.Char(36)

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  userCompanies       UserCompany[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  registeredDevices   RegisteredDevice[]
  chequeAllocations   ChequeNumberAllocation[]
  syncOperations      SyncOperation[]
  reportExportJobs    ReportExportJob[]
  backupJobs          BackupJob[]
  restoreJobs         RestoreJob[]
  auditLogs           AuditLog[]               @relation("AuditTenantUser")

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, status])
}

model Role {
  id            String       @id @default(uuid()) @db.Char(36)
  tenantId      String       @db.Char(36)
  code          String       @db.VarChar(64)
  name          String       @db.VarChar(120)
  description   String?      @db.Text
  isSystem      Boolean      @default(false)
  isClientAdmin Boolean      @default(false)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String?      @db.Char(36)
  updatedBy     String?      @db.Char(36)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(120)
  moduleKey   String   @db.VarChar(64)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([moduleKey])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Char(36)
  roleId       String   @db.Char(36)
  permissionId String   @db.Char(36)
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  userId    String   @db.Char(36)
  roleId    String   @db.Char(36)
  createdAt DateTime @default(now())
  createdBy String?  @db.Char(36)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId, userId])
}

model UserPermissionOverride {
  id           String           @id @default(uuid()) @db.Char(36)
  tenantId     String           @db.Char(36)
  userId       String           @db.Char(36)
  permissionId String           @db.Char(36)
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now())
  createdBy    String?          @db.Char(36)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([tenantId, userId])
}

model UserCompany {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  userId    String   @db.Char(36)
  companyId String   @db.Char(36)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String?  @db.Char(36)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([tenantId, userId])
  @@index([tenantId, companyId])
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  tenantId         String    @db.Char(36)
  userId           String    @db.Char(36)
  deviceId         String?   @db.Char(36)
  refreshTokenHash String    @unique @db.VarChar(128)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.Text
  isOfflineEnabled Boolean   @default(false)
  expiresAt        DateTime
  offlineExpiresAt DateTime?
  revokedAt        DateTime?
  revokedReason    String?   @db.VarChar(255)
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  device RegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id              String    @id @default(uuid()) @db.Char(36)
  actorType       ActorType
  platformAdminId String?   @db.Char(36)
  tenantId        String?   @db.Char(36)
  userId          String?   @db.Char(36)
  tokenHash       String    @unique @db.VarChar(128)
  expiresAt       DateTime
  usedAt          DateTime?
  ipAddress       String?   @db.VarChar(64)
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdministrator? @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  user          User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([platformAdminId, expiresAt])
}

model RegisteredDevice {
  id                String       @id @default(uuid()) @db.Char(36)
  tenantId          String       @db.Char(36)
  userId            String       @db.Char(36)
  deviceFingerprint String       @db.VarChar(191)
  deviceName        String       @db.VarChar(120)
  platform          String?      @db.VarChar(64)
  browser           String?      @db.VarChar(64)
  status            DeviceStatus @default(PENDING)
  lastSeenAt        DateTime?
  approvedBy        String?      @db.Char(36)
  approvedAt        DateTime?
  revokedBy         String?      @db.Char(36)
  revokedAt         DateTime?
  revocationReason  String?      @db.VarChar(255)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions            UserSession[]
  chequeAllocations   ChequeNumberAllocation[]
  originatedCheques   IssuedCheque[]
  calibrationProfiles ChequeCalibrationProfile[]
  syncOperations      SyncOperation[]
  syncLogs            SyncLog[]

  @@unique([tenantId, deviceFingerprint])
  @@index([tenantId, userId, status])
}

// ============================================================================
// 8.3 ORGANIZATION TABLES
// ============================================================================

model Company {
  id                     String       @id @default(uuid()) @db.Char(36)
  tenantId               String       @db.Char(36)
  companyCode            String       @db.VarChar(64)
  companyName            String       @db.VarChar(191)
  registeredBusinessName String?      @db.VarChar(191)
  registrationNumber     String?      @db.VarChar(100)
  address                String?      @db.Text
  city                   String?      @db.VarChar(100)
  country                String?      @db.VarChar(100)
  email                  String?      @db.VarChar(191)
  contactNumber          String?      @db.VarChar(50)
  website                String?      @db.VarChar(191)
  logoUrl                String?      @db.VarChar(500)
  isDefault              Boolean      @default(false)
  status                 RecordStatus @default(ACTIVE)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  createdBy              String?      @db.Char(36)
  updatedBy              String?      @db.Char(36)

  tenant            Tenant                   @relation("TenantCompanies", fields: [tenantId], references: [id], onDelete: Restrict)
  defaultForTenants Tenant[]                 @relation("TenantDefaultCompany")
  settings          CompanySetting?
  userCompanies     UserCompany[]
  bankAccounts      BankAccount[]
  bankTransactions  BankAccountTransaction[]
  bankAdjustments   BankAccountAdjustment[]
  chequeBooks       ChequeBook[]
  chequeAllocations ChequeNumberAllocation[]
  issuedCheques     IssuedCheque[]
  receivedCheques   ReceivedCheque[]
  chequeTemplates   ChequeTemplate[]
  reportExportJobs  ReportExportJob[]

  @@unique([tenantId, companyCode])
  @@index([tenantId, status])
  @@index([tenantId, isDefault])
}

model CompanySetting {
  id                      String   @id @default(uuid()) @db.Char(36)
  tenantId                String   @db.Char(36)
  companyId               String   @unique @db.Char(36)
  defaultCurrency         String?  @db.VarChar(10)
  defaultChequeDateFormat String?  @db.VarChar(32)
  defaultPayeePrefix      String?  @db.VarChar(64)
  settingsJson            Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ============================================================================
// 8.4 BANK TABLES
// ============================================================================

model Bank {
  id             String       @id @default(uuid()) @db.Char(36)
  ownerScope     String       @default("GLOBAL") @db.VarChar(36)
  tenantId       String?      @db.Char(36)
  isSystemShared Boolean      @default(false)
  bankCode       String       @db.VarChar(64)
  bankName       String       @db.VarChar(191)
  country        String       @db.VarChar(100)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      @db.Char(36)
  updatedBy      String?      @db.Char(36)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches        BankBranch[]
  bankAccounts    BankAccount[]
  issuedCheques   IssuedCheque[]
  receivedCheques ReceivedCheque[]
  chequeTemplates ChequeTemplate[]

  @@unique([ownerScope, bankCode])
  @@index([tenantId, status])
  @@index([isSystemShared, status])
}

model BankBranch {
  id             String       @id @default(uuid()) @db.Char(36)
  ownerScope     String       @default("GLOBAL") @db.VarChar(36)
  tenantId       String?      @db.Char(36)
  bankId         String       @db.Char(36)
  isSystemShared Boolean      @default(false)
  branchCode     String       @db.VarChar(64)
  branchName     String       @db.VarChar(191)
  address        String?      @db.Text
  city           String?      @db.VarChar(100)
  contactNumber  String?      @db.VarChar(50)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      @db.Char(36)
  updatedBy      String?      @db.Char(36)

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bank         Bank          @relation(fields: [bankId], references: [id], onDelete: Restrict)
  bankAccounts BankAccount[]

  @@unique([bankId, ownerScope, branchCode])
  @@index([tenantId, bankId, status])
}

model BankAccount {
  id                 String            @id @default(uuid()) @db.Char(36)
  tenantId           String            @db.Char(36)
  companyId          String            @db.Char(36)
  bankId             String            @db.Char(36)
  branchId           String?           @db.Char(36)
  accountName        String            @db.VarChar(191)
  accountNumber      String            @db.VarChar(64)
  accountType        BankAccountType   @default(CURRENT)
  currency           String            @default("LKR") @db.VarChar(10)
  openingBalance     Decimal           @default(0.00) @db.Decimal(18, 2)
  openingBalanceDate DateTime          @db.Date
  currentBookBalance Decimal           @default(0.00) @db.Decimal(18, 2)
  status             BankAccountStatus @default(ACTIVE)
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?           @db.Char(36)
  updatedBy          String?           @db.Char(36)

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bank            Bank                     @relation(fields: [bankId], references: [id], onDelete: Restrict)
  branch          BankBranch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transactions    BankAccountTransaction[]
  adjustments     BankAccountAdjustment[]
  chequeBooks     ChequeBook[]
  allocations     ChequeNumberAllocation[]
  issuedCheques   IssuedCheque[]
  receivedDeposits ReceivedCheque[]        @relation("ReceivedChequeDepositAccount")
  chequeTemplates ChequeTemplate[]

  @@unique([tenantId, bankId, accountNumber])
  @@index([tenantId, companyId, status])
}

model BankAccountTransaction {
  id                      String              @id @default(uuid()) @db.Char(36)
  tenantId                String              @db.Char(36)
  companyId               String              @db.Char(36)
  bankAccountId           String              @db.Char(36)
  transactionDate         DateTime
  transactionType         BankTransactionType
  referenceNumber         String?             @db.VarChar(100)
  description             String?             @db.Text
  debitAmount             Decimal             @default(0.00) @db.Decimal(18, 2)
  creditAmount            Decimal             @default(0.00) @db.Decimal(18, 2)
  balanceAfterTransaction Decimal             @db.Decimal(18, 2)
  issuedChequeId          String?             @db.Char(36)
  receivedChequeId        String?             @db.Char(36)
  reversedTransactionId   String?             @db.Char(36)
  idempotencyKey          String?             @db.VarChar(128)
  sequenceNumber          BigInt
  createdAt               DateTime            @default(now())
  createdBy               String?             @db.Char(36)

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount         BankAccount             @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  issuedCheque        IssuedCheque?           @relation(fields: [issuedChequeId], references: [id], onDelete: Restrict)
  receivedCheque      ReceivedCheque?         @relation(fields: [receivedChequeId], references: [id], onDelete: Restrict)
  reversedTransaction BankAccountTransaction? @relation("TransactionReversal", fields: [reversedTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversalEntries     BankAccountTransaction[] @relation("TransactionReversal")
  adjustments         BankAccountAdjustment[]

  @@unique([tenantId, idempotencyKey])
  @@unique([bankAccountId, sequenceNumber])
  @@index([tenantId, bankAccountId, transactionDate])
  @@index([tenantId, companyId, transactionDate])
  @@index([issuedChequeId])
  @@index([receivedChequeId])
}

model BankAccountAdjustment {
  id                  String           @id @default(uuid()) @db.Char(36)
  tenantId            String           @db.Char(36)
  companyId           String           @db.Char(36)
  bankAccountId       String           @db.Char(36)
  adjustmentType      AdjustmentType
  amount              Decimal          @db.Decimal(18, 2)
  reason              String           @db.Text
  status              AdjustmentStatus @default(PENDING)
  postedTransactionId String?          @db.Char(36)
  requestedBy         String           @db.Char(36)
  approvedBy          String?          @db.Char(36)
  approvedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount       BankAccount             @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  postedTransaction BankAccountTransaction? @relation(fields: [postedTransactionId], references: [id], onDelete: Restrict)

  @@index([tenantId, bankAccountId, status])
}

