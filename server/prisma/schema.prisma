model AuditLog {
  id              String    @id @default(uuid()) @db.Char(36)
  tenantId        String?   @db.Char(36)
  companyId       String?   @db.Char(36)
  userId          String?   @db.Char(36)
  platformAdminId String?   @db.Char(36)
  deviceId        String?   @db.Char(36)
  actorType       ActorType
  action          String    @db.VarChar(120)
  entityType      String    @db.VarChar(80)
  entityId        String?   @db.Char(36)
  previousValues  Json?
  newValues       Json?
  ipAddress       String?   @db.VarChar(64)
  userAgent       String?   @db.Text
  requestId       String?   @db.VarChar(64)
  createdAt       DateTime  @default(now())

  tenant        Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user          User?                  @relation("AuditTenantUser", fields: [userId], references: [id], onDelete: SetNull)
  platformAdmin PlatformAdministrator? @relation("AuditPlatformAdmin", fields: [platformAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([action, createdAt])
}

model AuthenticationLog {
  id              String        @id @default(uuid()) @db.Char(36)
  tenantId        String?       @db.Char(36)
  userId          String?       @db.Char(36)
  platformAdminId String?       @db.Char(36)
  actorType       ActorType
  identifierUsed  String        @db.VarChar(191)
  eventType       AuthEventType
  success         Boolean
  failureReason   String?       @db.VarChar(255)
  ipAddress       String?       @db.VarChar(64)
  userAgent       String?       @db.Text
  deviceId        String?       @db.Char(36)
  createdAt       DateTime      @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model SecurityEvent {
  id           String           @id @default(uuid()) @db.Char(36)
  tenantId     String?          @db.Char(36)
  userId       String?          @db.Char(36)
  actorType    ActorType?
  eventType    String           @db.VarChar(100)
  severity     SecuritySeverity @default(MEDIUM)
  description  String           @db.Text
  metadataJson Json?
  ipAddress    String?          @db.VarChar(64)
  requestPath  String?          @db.VarChar(255)
  createdAt    DateTime         @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, severity, createdAt])
  @@index([eventType, createdAt])
}
