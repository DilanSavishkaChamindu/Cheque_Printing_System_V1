model ChequeCalibrationProfile {
  id                   String    @id @default(uuid()) @db.Char(36)
  tenantId             String    @db.Char(36)
  templateId           String    @db.Char(36)
  deviceId             String?   @db.Char(36)
  profileName          String    @db.VarChar(120)
  offsetXMm            Decimal   @default(0.00) @db.Decimal(6, 2)
  offsetYMm            Decimal   @default(0.00) @db.Decimal(6, 2)
  scalePercent         Decimal   @default(100.00) @db.Decimal(5, 2)
  printerMarginTopMm   Decimal   @default(0.00) @db.Decimal(6, 2)
  printerMarginLeftMm  Decimal   @default(0.00) @db.Decimal(6, 2)
  isDefault            Boolean   @default(false)
  lastTestPrintedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?   @db.Char(36)
  updatedBy            String?   @db.Char(36)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template  ChequeTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  device    RegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  printJobs ChequePrintJob[]

  @@index([tenantId, templateId])
}

