  previousStatus String?              @db.VarChar(40)
  newStatus      String               @db.VarChar(40)
  reason         String?              @db.Text
  changedBy      String?              @db.Char(36)
  deviceId       String?              @db.Char(36)
  createdAt      DateTime             @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuedCheque IssuedCheque @relation(fields: [issuedChequeId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedChequeId, createdAt])
}

model ChequePrintJob {
  id                   String         @id @default(uuid()) @db.Char(36)
  tenantId             String         @db.Char(36)
  issuedChequeId       String         @db.Char(36)
  templateId           String?        @db.Char(36)
  calibrationProfileId String?        @db.Char(36)
  jobType              PrintJobType   @default(INITIAL_PRINT)
  status               PrintJobStatus @default(QUEUED)
  printerName          String?        @db.VarChar(191)
  paperSize            String?        @db.VarChar(64)
  scalePercent         Decimal?       @db.Decimal(5, 2)
  errorMessage         String?        @db.Text
