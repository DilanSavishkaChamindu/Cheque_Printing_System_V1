  @@index([tenantId, companyId, status])
  @@index([tenantId, receivedDate])
  @@index([tenantId, chequeDate])
  @@index([tenantId, chequeNumber])
}

model ReceivedChequeStatusHistory {
  id               String                @id @default(uuid()) @db.Char(36)
  tenantId         String                @db.Char(36)
  receivedChequeId String                @db.Char(36)
  previousStatus   ReceivedChequeStatus?
  newStatus        ReceivedChequeStatus
  reason           String?               @db.Text
  changedBy        String?               @db.Char(36)
  createdAt        DateTime              @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivedCheque ReceivedCheque @relation(fields: [receivedChequeId], references: [id], onDelete: Cascade)

  @@index([tenantId, receivedChequeId, createdAt])
}

