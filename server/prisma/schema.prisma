  printJobs           ChequePrintJob[]

  @@index([tenantId, bankId, status])
  @@index([tenantId, companyId])
}

model ChequeTemplateField {
  id               String           @id @default(uuid()) @db.Char(36)
  tenantId         String           @db.Char(36)
  templateId       String           @db.Char(36)
  fieldKey         TemplateFieldKey
  label            String           @db.VarChar(100)
  xMm              Decimal          @db.Decimal(8, 2)
  yMm              Decimal          @db.Decimal(8, 2)
  widthMm          Decimal          @db.Decimal(8, 2)
  heightMm         Decimal          @db.Decimal(8, 2)
  fontFamily       String           @default("Arial") @db.VarChar(80)
  fontSizePt       Decimal          @default(11.00) @db.Decimal(5, 2)
  fontWeight       String           @default("normal") @db.VarChar(32)
  letterSpacingMm  Decimal          @default(0.00) @db.Decimal(5, 2)
  lineHeight       Decimal          @default(1.20) @db.Decimal(5, 2)
  textAlign        TextAlignment    @default(LEFT)
  dateDigitGapMm   Decimal?         @db.Decimal(5, 2)
  isVisible        Boolean          @default(true)
  customConfigJson Json?

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
