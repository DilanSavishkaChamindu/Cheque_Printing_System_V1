  notes               String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdBy           String?          @db.Char(36)
  updatedBy           String?          @db.Char(36)

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount   BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  allocations   ChequeNumberAllocation[]
  issuedCheques IssuedCheque[]

  @@index([tenantId, bankAccountId, status])
  @@index([tenantId, companyId])
}

model ChequeNumberAllocation {
  id             String           @id @default(uuid()) @db.Char(36)
  tenantId       String           @db.Char(36)
  companyId      String           @db.Char(36)
  bankAccountId  String           @db.Char(36)
  chequeBookId   String           @db.Char(36)
  deviceId       String?          @db.Char(36)
  assignedUserId String?          @db.Char(36)
  rangeStart     Int
  rangeEnd       Int
  nextNumber     Int
  allocationType AllocationType   @default(OFFLINE_RANGE)
  status         AllocationStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      String?          @db.Char(36)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount   BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  chequeBook    ChequeBook        @relation(fields: [chequeBookId], references: [id], onDelete: Restrict)
  device        RegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  assignedUser  User?             @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  issuedCheques IssuedCheque[]

  @@index([tenantId, chequeBookId, status])
  @@index([tenantId, deviceId, status])
}

model IssuedCheque {
  id                  String               @id @default(uuid()) @db.Char(36)
  tenantId            String               @db.Char(36)
  companyId           String               @db.Char(36)
  bankId              String               @db.Char(36)
  bankAccountId       String               @db.Char(36)
  chequeBookId        String?              @db.Char(36)
  allocationId        String?              @db.Char(36)
  templateId          String?              @db.Char(36)
  chequeNumber        String               @db.VarChar(50)
  chequeNumberNumeric Int?
  chequeDate          DateTime             @db.Date
  dateFormat          String               @default("DD/MM/YYYY") @db.VarChar(32)
  payeeName           String               @db.VarChar(191)
  amount              Decimal              @db.Decimal(18, 2)
  currency            String               @default("LKR") @db.VarChar(10)
  paymentType         PaymentType          @default(ACCOUNT_PAYEE)
  cashRecipient       String?              @db.VarChar(191)
  amountInWords       String               @db.Text
  description         String?              @db.Text
  businessStatus      ChequeBusinessStatus @default(DRAFT)
  printingStatus      ChequePrintingStatus @default(NOT_PRINTED)
  bankingStatus       ChequeBankingStatus  @default(PENDING)
  printCount          Int                  @default(0)
  lastPrintedAt       DateTime?
  clearedAt           DateTime?
  bouncedAt           DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?              @db.Text
  isOfflineCreated    Boolean              @default(false)
  originDeviceId      String?              @db.Char(36)
  idempotencyKey      String?              @db.VarChar(128)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           String?              @db.Char(36)
  updatedBy           String?              @db.Char(36)

  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company          Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bank             Bank                        @relation(fields: [bankId], references: [id], onDelete: Restrict)
  bankAccount      BankAccount                 @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  chequeBook       ChequeBook?                 @relation(fields: [chequeBookId], references: [id], onDelete: Restrict)
  allocation       ChequeNumberAllocation?     @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  template         ChequeTemplate?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  originDevice     RegisteredDevice?           @relation(fields: [originDeviceId], references: [id], onDelete: SetNull)
  statusHistory    IssuedChequeStatusHistory[]
  printJobs        ChequePrintJob[]
  bankTransactions BankAccountTransaction[]

  @@unique([tenantId, bankAccountId, chequeNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, companyId, chequeDate])
  @@index([tenantId, businessStatus, bankingStatus, printingStatus])
  @@index([tenantId, payeeName])
}

model IssuedChequeStatusHistory {
  id             String               @id @default(uuid()) @db.Char(36)
  tenantId       String               @db.Char(36)
  issuedChequeId String               @db.Char(36)
