// 8.7 OFFLINE SYNCHRONIZATION TABLES
// ============================================================================

model SyncOperation {
  id              String              @id @default(uuid()) @db.Char(36)
  tenantId        String              @db.Char(36)
  userId          String              @db.Char(36)
  deviceId        String              @db.Char(36)
  operationId     String              @db.Char(36)
  idempotencyKey  String              @db.VarChar(128)
  entityType      String              @db.VarChar(64)
  recordId        String              @db.Char(36)
  operationType   SyncOperationType
  payloadJson     Json
  clientVersion   Int?
  status          SyncOperationStatus @default(PENDING)
  retryCount      Int                 @default(0)
  lastError       String?             @db.Text
  clientCreatedAt DateTime
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  device    RegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  conflicts SyncConflict[]
  logs      SyncLog[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, deviceId, createdAt])
}

model SyncConflict {
  id                 String                   @id @default(uuid()) @db.Char(36)
  tenantId           String                   @db.Char(36)
  syncOperationId    String                   @db.Char(36)
  entityType         String                   @db.VarChar(64)
  recordId           String                   @db.Char(36)
  conflictType       SyncConflictType
  localPayloadJson   Json
  serverSnapshotJson Json
  resolutionStatus   ConflictResolutionStatus @default(OPEN)
  resolutionNotes    String?                  @db.Text
  resolvedBy         String?                  @db.Char(36)
  resolvedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncOperation SyncOperation @relation(fields: [syncOperationId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolutionStatus, createdAt])
  @@index([tenantId, recordId])
}

model SyncLog {
  id              String   @id @default(uuid()) @db.Char(36)
  tenantId        String   @db.Char(36)
  userId          String?  @db.Char(36)
  deviceId        String?  @db.Char(36)
  syncOperationId String?  @db.Char(36)
  eventType       String   @db.VarChar(80)
  status          String   @db.VarChar(40)
  message         String   @db.Text
  detailsJson     Json?
  createdAt       DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device        RegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  syncOperation SyncOperation?    @relation(fields: [syncOperationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([syncOperationId])
}

