  template           ChequeTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  calibrationProfile ChequeCalibrationProfile? @relation(fields: [calibrationProfileId], references: [id], onDelete: SetNull)

  @@index([tenantId, issuedChequeId, printedAt])
}

model ReceivedCheque {
  id                   String               @id @default(uuid()) @db.Char(36)
  tenantId             String               @db.Char(36)
  companyId            String               @db.Char(36)
  chequeNumber         String               @db.VarChar(50)
  chequeDate           DateTime             @db.Date
  receivedDate         DateTime             @db.Date
  bankId               String?              @db.Char(36)
  bankName             String               @db.VarChar(191)
  branchName           String?              @db.VarChar(191)
  receivedFrom         String               @db.VarChar(191)
  amount               Decimal              @db.Decimal(18, 2)
  currency             String               @default("LKR") @db.VarChar(10)
  depositBankAccountId String?              @db.Char(36)
  depositedAt          DateTime?
  clearedAt            DateTime?
  note                 String?              @db.Text
  status               ReceivedChequeStatus @default(RECEIVED)
  version              Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdBy            String?              @db.Char(36)
  updatedBy            String?              @db.Char(36)

  tenant             Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
