# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MySQL 8.0 Connection
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://cheque_app:change_me_local_password@localhost:3306/cheque_printing_saas"

# CORS
CORS_ORIGIN="http://localhost:5173"

# JWT & Session Security (replace with strong 64+ char random secrets in production)
JWT_ACCESS_SECRET="replace-with-secure-64-char-random-access-secret-for-dev-only-01"
JWT_REFRESH_SECRET="replace-with-secure-64-char-random-refresh-secret-for-dev-only-02"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Initial Seed Platform Admin (used only by `npm run prisma:seed`)
SEED_PLATFORM_ADMIN_EMAIL="admin@chequesaas.local"
SEED_PLATFORM_ADMIN_USERNAME="platformadmin"
SEED_PLATFORM_ADMIN_PASSWORD="ChangeMe!2026"
